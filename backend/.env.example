# RightStaff AI Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# ==================== DATABASE ====================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rightstaff
POSTGRES_USER=right_staff
POSTGRES_PASSWORD=dev_password_123

# ==================== VECTOR DATABASE ====================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=candidates_v1
QDRANT_JOBS_COLLECTION=jobs_v1

# ==================== CACHE ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_123
REDIS_DB=0

# ==================== OBJECT STORAGE ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=rightstaff-resumes
MINIO_USE_SSL=false

# ==================== AI MODELS ====================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ==================== LLM API KEYS ====================
# OpenAI API Key (required for chatbot)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# OR use Anthropic Claude (alternative to OpenAI)
# ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# ==================== TEXT PROCESSING ====================
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# ==================== API SETTINGS ====================
DEBUG=false
ENV=development
API_RATE_LIMIT=100
MAX_FILE_SIZE_MB=5
